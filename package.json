{
  "name": "feedback-intake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/dev.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1162.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.16",
    "openai": "7.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  }
}
